{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenIndustry Vision Studio",
  "mainBinaryName": "OpenIndustry Vision Studio",
  "version": "0.1.0",
  "identifier": "com.openaiot.visionstudio",
  "build": {
    "beforeDevCommand": { "script": "node ../node_modules/vite/bin/vite.js", "cwd": "../frontend" },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": { "script": "npm run prepare:desktop", "cwd": ".." },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [{ "label": "main", "create": false, "title": "OpenIndustry Vision Studio", "width": 1280, "height": 840, "minWidth": 900, "minHeight": 640, "dragDropEnabled": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "publisher": "OpenAIoT",
    "shortDescription": "Industrial computer vision studio",
    "icon": ["icons/icon.ico"],
    "resources": { "../artifacts/backend/": "backend/" },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installMode": "perMachine", "languages": ["English"],
        "displayLanguageSelector": false, "installerHooks": "../installer/hooks.nsh"
      }
    }
  }
}
